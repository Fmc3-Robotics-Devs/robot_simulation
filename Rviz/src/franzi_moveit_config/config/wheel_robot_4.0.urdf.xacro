<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_robot_4.0">
  <!-- Keep the source description unchanged and add a massless root only for
       KDL, which cannot represent inertia on the root link. -->
  <xacro:include filename="$(find franzi_description)/urdf/wheel_robot_4.0.urdf"/>

  <link name="moveit_root"/>
  <joint name="moveit_root_joint" type="fixed">
    <parent link="moveit_root"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
